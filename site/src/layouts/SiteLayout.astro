---
import '../styles/site.css';
import '@fontsource-variable/jetbrains-mono';
import { getDocs, BASE } from '../lib/docs';

type Props = {
  title?: string;
  description?: string;
  pageClass?: string;
};

const docs = await getDocs();
const { title = 'RetroInk', description = 'RetroInk e-reader firmware documentation', pageClass = '' } = Astro.props;
const pageTitle = title === 'RetroInk' ? title : `${title} | RetroInk`;
const currentDoc = docs.find((doc) => Astro.url.pathname === doc.url);
const base = BASE;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <link rel="icon" type="image/svg+xml" href={`${base}favicon.svg?v=2`} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400..900&display=swap" rel="stylesheet" />
    <title>{pageTitle}</title>
  </head>
  <body class={pageClass}>
    <header class="site-header">
      <div class="brand">
        <a href={base} aria-label="RetroInk home">
          <svg class="brand-mark" viewBox="-1 -1 26 35" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
            <rect x="0" y="0" width="24" height="29" fill="none" stroke="currentColor" stroke-width="1.6" />
            <rect x="3" y="3" width="18" height="17" fill="none" stroke="currentColor" stroke-width="1.6" />
            <rect x="7" y="8" width="2" height="2" fill="currentColor" />
            <rect x="15" y="8" width="2" height="2" fill="currentColor" />
            <line x1="8" y1="14" x2="15" y2="14" stroke="currentColor" stroke-width="1.6" stroke-linecap="square" />
            <line x1="10" y1="24" x2="20" y2="24" stroke="currentColor" stroke-width="1.6" stroke-linecap="square" />
            <rect x="2" y="30" width="20" height="3" fill="none" stroke="currentColor" stroke-width="1.6" />
          </svg>
        </a>
        <span>
          <a class="brand-title" href={base}>
            <strong>RetroInk</strong>
          </a>
          <small>E-reader Firmware &middot; by <a href="https://altflow.dev">AltFlow</a></small>
        </span>
      </div>
      <nav class="top-nav" aria-label="Primary navigation">
        <a href={`${base}docs.html`}>Docs</a>
        <a href={`${base}installation.html`}>Install</a>
        <a href={`${base}reader-features.html`}>Features</a>
        <a href="https://github.com/smashedllama/retroink">GitHub</a>
      </nav>
    </header>
    <slot name="hero" />
    <div class="shell">
      <aside class="docs-sidebar" aria-label="Documentation navigation">
        <div class="sidebar-title">Documentation</div>
        <nav>
          {
            docs.map((doc) => (
              <a class:list={['sidebar-link', { active: Astro.url.pathname === doc.url }]} href={doc.url}>
                {doc.title}
              </a>
            ))
          }
        </nav>
      </aside>
      <main class="content">
        <details class="mobile-docs-nav">
          <summary>
            <span>Docs</span>
            {currentDoc && <strong>{currentDoc.title}</strong>}
          </summary>
          <nav aria-label="Mobile documentation navigation">
            {
              docs.map((doc) => (
                <a class:list={['mobile-docs-link', { active: Astro.url.pathname === doc.url }]} href={doc.url}>
                  {doc.title}
                </a>
              ))
            }
          </nav>
        </details>
        <slot />
      </main>
    </div>
    <footer class="site-footer">
      <a href="https://buymeacoffee.com/erunyan">Buy me a coffee</a>
    </footer>
  </body>
</html>
